---
import '../styles/global.css';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="ViridLand develops property with landowners. Net-zero operation. Buildings specified to stand for a century." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;1,9..40,300&display=swap" rel="stylesheet" />
		<title>{frontmatter.title}</title>
	</head>
	<body class="bg-persian-black text-ivory font-sans antialiased min-h-screen flex flex-col items-center justify-start px-6 py-12 md:px-10 md:py-16 lg:px-16 lg:py-20">
		<main class="w-full max-w-xl text-center mx-auto lg:max-w-2xl">
			<img
				src={`${base}ViridLand_Lockup_Master.png`}
				alt="ViridLand"
				class="mx-auto w-full max-w-xs mb-10 md:max-w-md md:mb-14 lg:max-w-lg lg:mb-16"
			/>
			<slot />
		</main>
	</body>
</html>
